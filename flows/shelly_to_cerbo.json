[
  {
    "id": "tab-shelly-pv",
    "type": "tab",
    "label": "Shelly PV → Cerbo GX",
    "disabled": false,
    "info": ""
  },
  {
    "id": "timer-10s",
    "type": "inject",
    "z": "tab-shelly-pv",
    "name": "Alle 10 Sekunden",
    "props": [{ "p": "payload" }],
    "repeat": "10",
    "crontab": "",
    "once": true,
    "onceDelay": 1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 160,
    "y": 200,
    "wires": [["http-get-shelly"]]
  },
  {
    "id": "http-get-shelly",
    "type": "http request",
    "z": "tab-shelly-pv",
    "name": "shelly-monitor abrufen",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://HIER-IP-EINTRAGEN:3000/api/data",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "x": 380,
    "y": 200,
    "wires": [["fn-extract-pv"]]
  },
  {
    "id": "fn-extract-pv",
    "type": "function",
    "z": "tab-shelly-pv",
    "name": "PV-Watt vorbereiten",
    "func": "const pv = msg.payload && msg.payload.current && msg.payload.current.pv;\nif (pv == null) {\n    node.status({ fill:'red', shape:'ring', text:'Keine Daten' });\n    return null;\n}\nconst watts = Math.round(pv);\n\nmsg.payload = {\n    'Ac/Power':      watts,\n    'Ac/L1/Power':   watts,\n    'Ac/L1/Voltage': 230.0,\n    'Ac/L1/Current': parseFloat((watts / 230).toFixed(2)),\n    'StatusCode':    7,\n    'Connected':     1\n};\n\nnode.status({\n    fill:  watts > 0 ? 'green' : 'grey',\n    shape: 'dot',\n    text:  watts + ' W'\n});\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 610,
    "y": 200,
    "wires": [["victron-pv-out", "debug-pv"]]
  },
  {
    "id": "victron-pv-out",
    "type": "victron-virtual-pvinverter",
    "z": "tab-shelly-pv",
    "name": "Shelly PV Messung",
    "deviceInstance": "30",
    "position": "1",
    "x": 850,
    "y": 200,
    "wires": []
  },
  {
    "id": "debug-pv",
    "type": "debug",
    "z": "tab-shelly-pv",
    "name": "Anzeige PV-Watt",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "payload[\"Ac/Power\"]",
    "statusType": "jsonata",
    "x": 850,
    "y": 280,
    "wires": []
  },
  {
    "id": "catch-http",
    "type": "catch",
    "z": "tab-shelly-pv",
    "name": "Verbindungsfehler",
    "scope": ["http-get-shelly"],
    "uncaught": false,
    "x": 380,
    "y": 320,
    "wires": [["debug-fehler"]]
  },
  {
    "id": "debug-fehler",
    "type": "debug",
    "z": "tab-shelly-pv",
    "name": "Fehler-Meldung",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "error.message",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 620,
    "y": 320,
    "wires": []
  }
]
