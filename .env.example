# Shelly PV Monitor – Konfiguration
# Kopiere diese Datei nach .env und trage deine Werte ein

# ── Shelly Cloud API ──────────────────────────────────────────────
# API-Schlüssel: home.shelly.cloud → Einstellungen → Benutzerkonto → Auth.-Cloud-Schlüssel
SHELLY_AUTH_KEY=dein-api-schluessel

# Server-URL: steht direkt neben dem API-Schlüssel im Shelly-Dashboard
SHELLY_SERVER_URL=https://shelly-103-eu.shelly.cloud

POLL_INTERVAL=10000
PORT=3000

# ── PV-Meter ──────────────────────────────────────────────────────
# Geräte-ID: Shelly-App → Gerät antippen → ⚙️ Einstellungen → Geräteinfo → Geräte-ID
# (sieht aus wie: e86beaedc9a4)

# 4× Shelly PM Mini
PV1_SHELLY_ID=geraete-id-pm-mini-1
PV1_SHELLY_TYPE=pm1

PV2_SHELLY_ID=geraete-id-pm-mini-2
PV2_SHELLY_TYPE=pm1

PV3_SHELLY_ID=geraete-id-pm-mini-3
PV3_SHELLY_TYPE=pm1

PV4_SHELLY_ID=geraete-id-pm-mini-4
PV4_SHELLY_TYPE=pm1

# Shelly Plus Plug S (Gen2)
PV5_SHELLY_ID=geraete-id-plus-plug-s
PV5_SHELLY_TYPE=switch

# ── Netzanschluss ─────────────────────────────────────────────────
# Shelly Pro 3EM
GRID_SHELLY_ID=geraete-id-pro-3em
GRID_SHELLY_TYPE=em3

# ── Verfügbare Gerätetypen ────────────────────────────────────────
#   pm1    → Shelly PM Mini, Shelly Plus 1PM
#   em3    → Shelly Pro 3EM
#   em     → Shelly Pro EM-50
#   switch → Shelly Plus Plug S
#   gen1   → Shelly Plug S (ältere Version)
