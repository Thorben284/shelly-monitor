# Shelly PV Monitor - Konfiguration
# Kopiere diese Datei nach .env und passe die Werte an

PORT=3000
POLL_INTERVAL=5000

# PV-Wechselrichter / Solar-Shelly (z.B. Shelly EM, 3EM, Pro EM)
PV_SHELLY_HOST=192.168.1.100
PV_SHELLY_GEN=1        # 1 = Gen1 (Shelly EM/3EM), 2 = Gen2+ (Shelly Pro EM)
PV_SHELLY_CHANNEL=0    # Kanal-Index (0 oder 1 beim Shelly EM)

# Netzanschluss-Shelly (optional – für Hausverbrauch-Berechnung)
# Positiver Wert = Netzbezug, negativer Wert = Einspeisung
GRID_SHELLY_HOST=192.168.1.101
GRID_SHELLY_GEN=1
GRID_SHELLY_CHANNEL=0

# Simulationsmodus (wird automatisch aktiviert wenn PV_SHELLY_HOST nicht gesetzt)
# SIMULATE=true
