# Shelly PV Monitor – Konfiguration
# Kopiere diese Datei nach .env und passe die IP-Adressen an

PORT=3000
POLL_INTERVAL=5000

# ── PV-Wechselrichter ─────────────────────────────────────────────
# Erster PV-Shelly (z.B. Shelly PM Mini)
PV_SHELLY_HOST=192.168.1.XXX
PV_SHELLY_TYPE=pm1

# Zweiter PV-Shelly (z.B. Shelly Plug S) – optional, wird addiert
PV2_SHELLY_HOST=192.168.1.XXX
PV2_SHELLY_TYPE=gen1       # gen1 = alter Plug S  |  switch = Plus Plug S

# ── Netzanschluss ─────────────────────────────────────────────────
# Shelly Pro 3EM (misst alle 3 Phasen am Hauptverteiler)
# positiv = Netzbezug, negativ = Einspeisung ins Netz
GRID_SHELLY_HOST=192.168.1.YYY
GRID_SHELLY_TYPE=em3

# ── Verfügbare Gerätetypen ────────────────────────────────────────
#   pm1    → Shelly PM Mini, Shelly Plus 1PM           (Gen2/3)
#   em3    → Shelly Pro 3EM                            (Gen2)
#   em     → Shelly Pro EM-50                          (Gen2)
#   switch → Shelly Plus Plug S, Shelly Plug S Gen2    (Gen2)
#   gen1   → Shelly Plug S (alt), Shelly 1PM           (Gen1)

# ── Shelly Plug S (optional, für einzelne Verbraucher) ────────────
# Wenn du den Plug S z.B. am Wechselrichter oder einem Gerät hast:
# PV_SHELLY_HOST=192.168.1.ZZZ
# PV_SHELLY_TYPE=gen1        # alter Plug S
# PV_SHELLY_TYPE=switch      # Plus Plug S (neuere Version)

# ── Simulationsmodus ──────────────────────────────────────────────
# Wird automatisch aktiviert wenn PV_SHELLY_HOST nicht gesetzt ist.
# Zum manuellen Aktivieren:
# SIMULATE=true
