# Shelly PV Monitor – Konfiguration
# Für Railway: alle Variablen im Railway-Dashboard unter "Variables" eintragen

# ── Shelly Cloud API ──────────────────────────────────────────────
# API-Schlüssel: home.shelly.cloud → Einstellungen → Auth.-Cloud-Schlüssel
SHELLY_AUTH_KEY=hier-deinen-api-schluessel-eintragen
SHELLY_SERVER_URL=https://shelly-175-eu.shelly.cloud

POLL_INTERVAL=10000
PORT=3000

# ── PV-Meter (werden alle summiert) ───────────────────────────────
PV1_SHELLY_ID=d48afc481be0
PV1_SHELLY_TYPE=switch

PV2_SHELLY_ID=34b7da8ad1f4
PV2_SHELLY_TYPE=pm1

PV3_SHELLY_ID=ecda3bc15810
PV3_SHELLY_TYPE=pm1

PV4_SHELLY_ID=5432046cd7a0
PV4_SHELLY_TYPE=pm1

PV5_SHELLY_ID=ecda3bc13404
PV5_SHELLY_TYPE=pm1

# ── Netzanschluss (Shelly Pro 3EM) ───────────────────────────────
GRID_SHELLY_ID=34987a455114
GRID_SHELLY_TYPE=em3

# ── Victron Cerbo GX Integration (optional) ───────────────────────
# IP-Adresse des Cerbo GX im lokalen Netz (leer lassen = MQTT deaktiviert)
# CERBO_MQTT_HOST=192.168.1.200
# CERBO_MQTT_PORT=1883
# CERBO_MQTT_TOPIC=shellies/pv_monitor
