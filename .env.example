# Shelly PV Monitor – Konfiguration
# Kopiere diese Datei nach .env und passe die IP-Adressen an

PORT=3000
POLL_INTERVAL=5000

# ── PV-Meter (alle werden summiert) ───────────────────────────────
# 4× Shelly PM Mini
PV1_SHELLY_HOST=192.168.1.101
PV1_SHELLY_TYPE=pm1

PV2_SHELLY_HOST=192.168.1.102
PV2_SHELLY_TYPE=pm1

PV3_SHELLY_HOST=192.168.1.103
PV3_SHELLY_TYPE=pm1

PV4_SHELLY_HOST=192.168.1.104
PV4_SHELLY_TYPE=pm1

# Shelly Plus Plug S (Gen2)
PV5_SHELLY_HOST=192.168.1.105
PV5_SHELLY_TYPE=switch

# ── Netzanschluss ─────────────────────────────────────────────────
# Shelly Pro 3EM (alle 3 Phasen werden summiert)
GRID_SHELLY_HOST=192.168.1.100
GRID_SHELLY_TYPE=em3

# ── Verfügbare Gerätetypen ────────────────────────────────────────
#   pm1    → Shelly PM Mini, Shelly Plus 1PM     (Gen2/3)
#   em3    → Shelly Pro 3EM                      (Gen2)
#   em     → Shelly Pro EM-50                    (Gen2)
#   switch → Shelly Plus Plug S                  (Gen2)
#   gen1   → Shelly Plug S (ältere Version)      (Gen1)

# ── Simulationsmodus ──────────────────────────────────────────────
# Wird automatisch aktiviert wenn keine PV-Meter konfiguriert sind.
# SIMULATE=true
