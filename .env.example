# ════════════════════════════════════════════════════════════════
#  Energie-Zentrale – Konfiguration
#  Kopiere diese Datei nach .env und fülle die Werte aus.
#  Für Railway/Render: Variablen im Dashboard unter "Variables".
# ════════════════════════════════════════════════════════════════

PORT=3000
POLL_INTERVAL=10000

# ── Shelly Cloud ─────────────────────────────────────────────────
# API-Schlüssel: home.shelly.cloud → Einstellungen → Auth.-Cloud-Schlüssel
SHELLY_AUTH_KEY=dein-api-schluessel-hier
SHELLY_SERVER_URL=https://shelly-175-eu.shelly.cloud

# PV-Meter (alle Werte werden summiert)
PV1_SHELLY_ID=d48afc481be0
PV1_SHELLY_TYPE=switch

PV2_SHELLY_ID=34b7da8ad1f4
PV2_SHELLY_TYPE=pm1

PV3_SHELLY_ID=ecda3bc15810
PV3_SHELLY_TYPE=pm1

PV4_SHELLY_ID=5432046cd7a0
PV4_SHELLY_TYPE=pm1

PV5_SHELLY_ID=ecda3bc13404
PV5_SHELLY_TYPE=pm1

# Netzanschluss (Shelly Pro 3EM)
GRID_SHELLY_ID=34987a455114
GRID_SHELLY_TYPE=em3

# Heizstab (wird separat angezeigt)
HEIZSTAB_SHELLY_ID=deine-heizstab-device-id
HEIZSTAB_SHELLY_TYPE=pm1

# ── Victron VRM ──────────────────────────────────────────────────
# Zugangsdaten: vrm.victronenergy.com → Profil → API
# Option A: E-Mail + Passwort (Server loggt sich automatisch ein)
VICTRON_EMAIL=deine@email.de
VICTRON_PASSWORD=dein-vrm-passwort

# Option B: Direkt ein API-Token (überschreibt E-Mail/Passwort)
# VICTRON_TOKEN=dein-api-token

# Installation-ID aus der VRM-URL (z.B. /installation/459608/)
VICTRON_SITE_ID=459608

# ── eufy Sicherheitskameras (optional) ───────────────────────────
# eufy-App-Zugangsdaten (gleiche wie in der eufy Security App)
EUFY_EMAIL=deine@email.de
EUFY_PASSWORD=dein-eufy-passwort
EUFY_COUNTRY=DE

# ── Home Assistant (Jarvis) ──────────────────────────────────────
# Token: HA → Profil → Sicherheit → Langlebiges Zugriffstoken
HA_URL=http://127.0.0.1:8123
HA_TOKEN=dein-ha-token

# Geräte ausblenden (Teile von Name oder ID, kommagetrennt), z. B. Shelly-Nebenschalter
# JARVIS_HIDE=led,firmware,eco_modus

# PIN für alle Haus-Funktionen (Schalten, Kameras). Leer = keine PIN.
# Dringend empfohlen, wenn Gäste oder Kinder im WLAN sind.
JARVIS_PIN=

# ── Waschmaschine ────────────────────────────────────────────────
# Bosch über Home Connect (IDs aus Home Assistant kopieren, Anleitung Abschnitt 5)
# WASCHMASCHINE_STATUS_ENTITY=sensor.waschmaschine_betriebszustand
# WASCHMASCHINE_ENDE_ENTITY=sensor.waschmaschine_endzeit
# Alternative ohne Cloud: Leistungssensor eines messenden Zwischensteckers
# WASCHMASCHINE_POWER_ENTITY=sensor.waschmaschine_leistung

# Geräteprüfung: alle N Minuten neue/entfernte Geräte in Home Assistant melden (Standard 60)
JARVIS_PRUEFUNG_MIN=60
# Kamera-Standbilder alle N Minuten neu laden (Standard 10; schont Akku-Kameras)
JARVIS_KAMERA_MIN=10

# Adresse der eufy-Brücke für den Systemcheck (Standard ws://127.0.0.1:3001)
# EUFY_WS_URL=ws://127.0.0.1:3001

# Ab welcher Einspeisung (Watt, 5 Min. lang) Jarvis „PV-Überschuss“ meldet
JARVIS_UEBERSCHUSS_W=1500

# ── KI-Fragen (optional) ─────────────────────────────────────────
# Schlüssel: console.anthropic.com → API Keys. Ohne Schlüssel laufen nur die festen Befehle.
# ANTHROPIC_API_KEY=
# Modell: Standard claude-opus-5-5 (beste Antworten, je nach Geräteanzahl etwa 1–3 Cent je Frage).
# Deutlich günstiger: claude-haiku-5-5 (Bruchteil eines Cents je Frage).
# JARVIS_MODEL=claude-haiku-5-5
