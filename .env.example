# ════════════════════════════════════════════════════════════════
#  Energie-Zentrale – Konfiguration
#  Kopiere diese Datei nach .env und fülle die Werte aus.
#  Für Railway/Render: Variablen im Dashboard unter "Variables".
# ════════════════════════════════════════════════════════════════

PORT=3000
POLL_INTERVAL=10000

# ── Shelly Cloud ─────────────────────────────────────────────────
# API-Schlüssel: home.shelly.cloud → Einstellungen → Auth.-Cloud-Schlüssel
SHELLY_AUTH_KEY=dein-api-schluessel-hier
SHELLY_SERVER_URL=https://shelly-175-eu.shelly.cloud

# PV-Meter (alle Werte werden summiert)
PV1_SHELLY_ID=d48afc481be0
PV1_SHELLY_TYPE=switch

PV2_SHELLY_ID=34b7da8ad1f4
PV2_SHELLY_TYPE=pm1

PV3_SHELLY_ID=ecda3bc15810
PV3_SHELLY_TYPE=pm1

PV4_SHELLY_ID=5432046cd7a0
PV4_SHELLY_TYPE=pm1

PV5_SHELLY_ID=ecda3bc13404
PV5_SHELLY_TYPE=pm1

# Netzanschluss (Shelly Pro 3EM)
GRID_SHELLY_ID=34987a455114
GRID_SHELLY_TYPE=em3

# Heizstab (wird separat angezeigt)
HEIZSTAB_SHELLY_ID=deine-heizstab-device-id
HEIZSTAB_SHELLY_TYPE=pm1

# ── Victron VRM ──────────────────────────────────────────────────
# Zugangsdaten: vrm.victronenergy.com → Profil → API
# Option A: E-Mail + Passwort (Server loggt sich automatisch ein)
VICTRON_EMAIL=deine@email.de
VICTRON_PASSWORD=dein-vrm-passwort

# Option B: Direkt ein API-Token (überschreibt E-Mail/Passwort)
# VICTRON_TOKEN=dein-api-token

# Installation-ID aus der VRM-URL (z.B. /installation/459608/)
VICTRON_SITE_ID=459608

# ── eufy Sicherheitskameras (optional) ───────────────────────────
# eufy-App-Zugangsdaten (gleiche wie in der eufy Security App)
EUFY_EMAIL=deine@email.de
EUFY_PASSWORD=dein-eufy-passwort
EUFY_COUNTRY=DE
